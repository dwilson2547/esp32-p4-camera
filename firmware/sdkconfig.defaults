CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# PSRAM at 200 MHz (gated behind experimental features) for camera + frame buffers
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# esp_video: MIPI-CSI capture + ISP with AE/AWB pipeline
CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_ISP_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y

# Camera is an IMX477 (Raspberry Pi HQ Camera)
CONFIG_CAMERA_IMX477=y
CONFIG_CAMERA_IMX477_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_IMX477_HMIRROR=y
# CONFIG_CAMERA_IMX477_TEST_PATTERN_AT_START is not set
CONFIG_ESP_IPA_AF_ALGORITHM=n

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# The touch panel reports coordinates rotated 180 degrees from the picture
# (checked on hardware: the bottom-right button fired from the top-left corner).
CONFIG_ESP_LCD_RPI_DSI_TOUCH_INVERT_X=y
CONFIG_ESP_LCD_RPI_DSI_TOUCH_INVERT_Y=y
