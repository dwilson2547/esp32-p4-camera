            },
            "mode": "low_light_priority",
            "high_light_priority": {
                "low_threshold": 120,
                "high_threshold": 180,
                "weight_offset": 5,
                "luma_offset": 5
            },
            "low_light_priority": {
                "low_threshold": 40,
                "high_threshold": 80,
                "weight_offset": 10,
                "luma_offset": 10
            }
        },
        "aen": {
