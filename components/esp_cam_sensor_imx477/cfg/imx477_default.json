        "awb": {
            "//range": "rg/bg box covers the IMX477 ct_curve from Raspberry Pi libcamera src/ipa/rpi/vc4/data/imx477.json (BSD-2-Clause), fetched 2026-11-09 (2360 K: rg 0.601 bg 0.309 ... 9505 K: rg 0.252 bg 0.786) with margin on the low side. Upper bounds stay 1.2 because it is unverified whether the stats are sampled before or after the WB gains (after = neutrals near 1.0). green 40-230 so ordinary-brightness scenes count, not just near-white patches. Gain step 0.03 instead of 0.5 so it tracks smoothly.",
            "model": 0,
            "min_counted": 1000,
            "min_red_gain_step": 0.03,
            "min_blue_gain_step": 0.03,
            "red_gain_scale": 1.0,
            "blue_gain_scale": 1.0,
            "range": {
                "green": {
                    "max": 230,
                    "min": 40
